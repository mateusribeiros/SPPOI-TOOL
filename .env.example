# Local development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=django-insecure-change-me

# Hugging Face token used for technical analysis generation
HF_API_TOKEN=hf_your_token_here

# Keep local project data during repeated development tests
SPPOI_DEV_PERSIST_PROJECTS=True

# Automatically open the browser when running `python manage.py runserver`
SPPOI_AUTO_OPEN_BROWSER=True
